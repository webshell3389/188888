# MockC2 部署环境变量模板：cp .env.example .env 后修改
# （docker compose 读取；至少必须修改所有 CHANGE-ME 项）

# ── 应用 ──
MOCKC2_ADMIN_PASSWORD=CHANGE-ME-strong-password
# 多实例必须一致（会话 HMAC 密钥）；留空则由 admin_password 派生
MOCKC2_SESSION_SECRET=
MOCKC2_OPS_TOKEN=

# ── MySQL ──
MYSQL_ROOT_PASSWORD=CHANGE-ME-root-password
MOCKC2_DB_NAME=mockc2
MOCKC2_DB_USER=mockc2
MOCKC2_DB_PASSWORD=CHANGE-ME-db-password

# ── 可选 ──
TZ=Asia/Shanghai
